<?xml version="1.0" encoding="utf-8"?>
<!--
    Компоновка повторяет окно первого запуска десктопной версии
    (ui/ctk_tray_ui.py:populate_first_run_window): синяя полоса-акцент слева
    от заголовка, блок «Как подключить», разделитель, крупная синяя кнопка.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- заголовок с акцентной полосой -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/accent_bar"
                android:layout_width="4dp"
                android:layout_height="34dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_accent_bar" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/title_stopped" />
        </LinearLayout>

        <!-- карточка состояния -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/stats_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:text="@string/stats_idle" />

            <TextView
                android:id="@+id/stats_traffic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <!-- Режим живучести: свой туннель, чужой VPN или ничего. -->
            <TextView
                android:id="@+id/tunnel_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- как подключить -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="10dp"
            android:text="@string/how_to" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:text="@string/auto" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="2dp"
            android:text="@string/auto_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp"
            android:text="@string/auto_link" />

        <TextView
            android:id="@+id/link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/tg_blue"
            android:textIsSelectable="true"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="14dp"
            android:text="@string/manual" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/manual_path" />

        <TextView
            android:id="@+id/manual_mtproto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/tg_blue"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/manual_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/tg_blue"
            android:textIsSelectable="true"
            android:layout_marginTop="2dp" />

        <!-- разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/field_border"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="18dp" />

        <!-- действия -->
        <Button
            android:id="@+id/btn_toggle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/text_on_blue"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:text="@string/btn_start" />

        <Button
            android:id="@+id/btn_open_telegram"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_secondary"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:text="@string/btn_open_telegram" />

        <Button
            android:id="@+id/btn_copy"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_secondary"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:text="@string/btn_copy" />

        <!-- остальные пункты меню трея десктопной версии -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_restart"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:text="@string/btn_restart" />

            <Button
                android:id="@+id/btn_logs"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_secondary"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:text="@string/btn_logs" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_secondary"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:text="@string/btn_settings" />

        <!-- диагностика -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="22dp"
            android:text="@string/diag_title" />

        <TextView
            android:id="@+id/diag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp" />

        <!--
            Распорка с весом прижимает подпись к низу экрана. Работает потому,
            что у ScrollView выставлен fillViewport="true": при коротком
            содержимом контейнер растягивается на всю высоту.
        -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!--
            Подпись из двух блоков. Текст со ссылками размечается кодом
            (MainActivity.fillSignature): в XML нельзя сделать кликабельным
            отдельный фрагмент строки, а autoLink подсвечивает только сами
            URL, а не произвольные слова вроде «Flowseal».
        -->
        <TextView
            android:id="@+id/signature_based"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/signature"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/signature_by"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="9sp"
            android:letterSpacing="0.04"
            android:textColor="@color/signature_dim"
            android:paddingTop="4dp"
            android:paddingBottom="2dp" />
    </LinearLayout>
</ScrollView>
